# Copy to .env and fill in. Never commit .env.

# RCON password for the TF2 server (director uses this to send ai_say commands)
RCON_PASSWORD=change-me

# --- LLM backend -----------------------------------------------------------
# "ollama"  = local model, free, CPU-only (default). Leaves the GPU for TF2.
# "anthropic" = Claude API (best quality; needs ANTHROPIC_API_KEY + credits).
LLM_BACKEND=ollama

# Local (Ollama) settings — used when LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:3b-instruct

# Anthropic settings — used when LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
AILOBBY_MODEL=claude-haiku-4-5

# Optional: password players need to join the server (empty = open)
SERVER_PASSWORD=

# Steam Game Server Login Token (AppID 440) — required for the VPS rig only.
# https://steamcommunity.com/dev/managegameservers
SRCDS_TOKEN=

# Shared secret for sv_logsecret. REQUIRED on the VPS (spoofed UDP log packets
# are trivial otherwise). Optional locally. If set, also add
#   sv_logsecret <value>
# to server/cfg/ailobby.cfg (cfg files can't read env vars).
LOG_SECRET=
